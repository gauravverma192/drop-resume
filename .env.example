# Copy to .env.local and fill in. Every variable below is optional for a first
# `npm run dev` - see the "Running without cloud credentials" note in the README.

# --- Supabase project (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for private-bucket storage writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings -> Database -> Connection string) ---
# Transaction pooler, port 6543. Used by the app at runtime. Prisma 7 talks to it
# through the pg driver adapter, which caps the pool in code, so the old
# `pgbouncer=true&connection_limit=1` query params are no longer needed.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Session pooler, port 5432. Used by the Prisma CLI for migrations. The
# `db.PROJECT.supabase.co` host is IPv6-only; this pooler URL is the IPv4 path.
# If the password contains @, /, or #, URL-encode those characters (e.g. @ → %40).
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Optional, and only needed to author a new migration with `npm run db:migrate`.
# `migrate dev` wants a scratch database it can create and drop, which Supabase does
# not allow; point this at a throwaway local Postgres (`npx prisma dev` prints one).
SHADOW_DATABASE_URL=

# --- Gemini (https://aistudio.google.com/apikey) ---
# When absent, resume parsing returns fixed placeholder fields instead of calling the API.
GEMINI_API_KEY=

# --- Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ---
# When TURNSTILE_SECRET_KEY is absent, the public form's bot check is bypassed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
# Salts the hashed IP used for rate limiting. Any long random string: `openssl rand -hex 32`.
APP_SALT=
# Origin used to build shareable role links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
