# Copy to .env.local and fill in. Every variable below is optional for a first
# `npm run dev` - see the "Running without cloud credentials" note in the README.

# --- Supabase project (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for private-bucket storage writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings -> Database -> Connection string) ---
# Transaction pooler, port 6543. Used by Prisma at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection, port 5432. Used by Prisma Migrate only.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# --- Gemini (https://aistudio.google.com/apikey) ---
# When absent, resume parsing returns fixed placeholder fields instead of calling the API.
GEMINI_API_KEY=

# --- Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ---
# When TURNSTILE_SECRET_KEY is absent, the public form's bot check is bypassed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
# Salts the hashed IP used for rate limiting. Any long random string: `openssl rand -hex 32`.
APP_SALT=
# Origin used to build shareable role links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
